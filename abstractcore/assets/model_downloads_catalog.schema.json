{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abstractframework.local/abstractcore/model_downloads_catalog.schema.json",
  "title": "AbstractCore Model Downloads Catalog",
  "description": "Curated, downloadable local models with per-engine artifact references. Read by abstractcore.config.model_catalog; enriched at runtime with presence, fit and (optionally) Hugging Face sizes.",
  "type": "object",
  "required": ["schema", "version", "rows"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "model_downloads_catalog_v1"},
    "version": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "notes": {"type": "string"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "row": {
      "type": "object",
      "required": ["id", "family", "display_name", "vendor", "params_total", "params_active", "license", "capabilities_key", "tags", "starter", "artifacts"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
        "family": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "params_total": {"type": ["integer", "null"], "minimum": 1},
        "params_active": {"type": ["integer", "null"], "minimum": 1},
        "license": {"type": ["string", "null"]},
        "capabilities_key": {"type": ["string", "null"], "description": "Key (or alias) in model_capabilities.json; null when the registry has no entry."},
        "tags": {"type": "array", "items": {"type": "string"}},
        "starter": {"type": "boolean", "description": "Part of RECOMMENDED_MODEL_DOWNLOADS (the fresh-install set)."},
        "notes": {"type": "string"},
        "capabilities_override": {"type": "object"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["provider", "artifact", "quant", "download_bytes", "size_source", "verified"],
      "properties": {
        "provider": {"type": "string", "enum": ["ollama", "lmstudio", "mlx", "huggingface", "mlx-gen", "mlx-vlm", "diffusers", "supertonic"]},
        "artifact": {"type": "string", "minLength": 1},
        "quant": {"type": ["string", "null"]},
        "download_bytes": {"type": ["integer", "null"], "minimum": 1},
        "size_source": {"type": "string", "enum": ["catalog", "unknown"]},
        "verified": {"type": "boolean", "description": "The id was seen on a real engine store or cache when the seed was built."},
        "recommended": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
