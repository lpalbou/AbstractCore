{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abstractframework.local/abstractcore/model_downloads_catalog.schema.json",
  "title": "AbstractCore Model Downloads Catalog",
  "description": "Curated, downloadable local models with per-engine artifact references. Read by abstractcore.config.model_catalog; enriched at runtime with presence, fit and (optionally) Hugging Face sizes.",
  "type": "object",
  "required": ["schema", "version", "rows"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "model_downloads_catalog_v1"},
    "version": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "notes": {"type": "string"},
    "companion_sizes": {
      "type": "object",
      "description": "Verified sizes of the companion repos (MTP drafters) the MLX drafter registry names for seed artifacts. WHICH companions an artifact has comes from the registry (speculation.mlx_companion_repos), never from this file.",
      "additionalProperties": {
        "type": "object",
        "required": ["download_bytes", "upstream"],
        "properties": {
          "download_bytes": {"type": "integer", "minimum": 1},
          "upstream": {"$ref": "#/$defs/upstream"}
        },
        "additionalProperties": false
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "upstream": {
      "type": "object",
      "description": "The id was verified to exist upstream on `checked`: hf_api = HfApi.model_info(files_metadata=True), download_bytes = the weight files; ollama_registry = the registry manifest, download_bytes = the sum of its layers. Requires the verified size.",
      "required": ["method", "checked"],
      "properties": {
        "method": {"enum": ["hf_api", "ollama_registry"]},
        "checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "revision": {"type": "string"}
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": ["id", "family", "display_name", "vendor", "params_total", "params_active", "license", "capabilities_key", "tags", "starter", "artifacts"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
        "family": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "params_total": {"type": ["integer", "null"], "minimum": 1},
        "params_active": {"type": ["integer", "null"], "minimum": 1},
        "license": {"type": ["string", "null"]},
        "capabilities_key": {"type": ["string", "null"], "description": "Key (or alias) in model_capabilities.json; null when the registry has no entry."},
        "tags": {"type": "array", "items": {"type": "string"}},
        "starter": {"type": "boolean", "description": "Part of RECOMMENDED_MODEL_DOWNLOADS (the fresh-install set)."},
        "notes": {"type": "string"},
        "capabilities_override": {"type": "object"},
        "kv_geometry": {
          "type": "object",
          "description": "KV-cached attention geometry read from the upstream config.json, used by the fit estimate before the model is installed. A hybrid model counts only its full-attention layers.",
          "required": ["n_layers", "n_kv_heads", "head_dim", "source"],
          "properties": {
            "n_layers": {"type": "integer", "minimum": 1},
            "n_kv_heads": {"type": "integer", "minimum": 1},
            "head_dim": {"type": "integer", "minimum": 1},
            "source": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["provider", "artifact", "quant", "download_bytes", "size_source", "verified"],
      "properties": {
        "provider": {"type": "string", "enum": ["ollama", "lmstudio", "mlx", "huggingface", "mlx-gen", "mlx-vlm", "diffusers", "supertonic"]},
        "artifact": {"type": "string", "minLength": 1},
        "quant": {"type": ["string", "null"]},
        "download_bytes": {"type": ["integer", "null"], "minimum": 1},
        "size_source": {"type": "string", "enum": ["catalog", "unknown"]},
        "verified": {"type": "boolean", "description": "The id was seen on a real engine store or cache when the seed was built."},
        "recommended": {"type": "boolean", "description": "The portable (non-Apple-silicon) curated pre-selection. On Apple silicon the text-tier rows pre-select model_catalog.APPLE_TEXT_TIERS instead."},
        "options": {
          "type": "object",
          "description": "Route options a recommendation copies with this artifact (the MTP builds: speculation, validated by providers/speculation.py).",
          "properties": {"speculation": {}},
          "additionalProperties": false
        },
        "note": {"type": "string", "minLength": 1},
        "upstream": {"$ref": "#/$defs/upstream"}
      },
      "if": {"required": ["upstream"]},
      "then": {"properties": {"download_bytes": {"type": "integer", "minimum": 1}, "size_source": {"const": "catalog"}}},
      "additionalProperties": false
    }
  }
}
